{
  "name": "@ga/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Public HTTPS (HTTP/2 + HTTP/1.1) REST API. Translates REST to gRPC calls on the domain services.",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --config-file ../../.swcrc --ignore \"**/*.spec.ts\" && node ../../tools/check-esm.ts",
    "start": "node --enable-source-maps --env-file-if-exists=.env --import @ga/service-kit/telemetry dist/main.js",
    "dev": "node ../../tools/dev.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/otel": "catalog:",
    "@ga/contracts": "workspace:*",
    "@ga/kernel": "workspace:*",
    "@ga/service-kit": "workspace:*",
    "@grpc/grpc-js": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/microservices": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@scalar/nestjs-api-reference": "catalog:",
    "fastify": "catalog:",
    "jose": "catalog:",
    "nestjs-cls": "catalog:",
    "nestjs-pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "catalog:",
    "grpc-health-check": "catalog:",
    "undici": "catalog:"
  }
}
