# Local development values (copy to .env). Validated at boot by src/config.ts.
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8443
TLS_ENABLED=true
TLS_CERT_FILE=../../.certs/dev-cert.pem
TLS_KEY_FILE=../../.certs/dev-key.pem
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=600
# /docs and /openapi.json; defaults to off when NODE_ENV=production
DOCS_ENABLED=true
# CA of the services' gRPC certificates (pnpm certs)
GRPC_TLS_CA_FILE=../../.certs/grpc-ca.pem
USER_SERVICE_URL=localhost:50051
HOUSE_SERVICE_URL=localhost:50052
BOOKING_SERVICE_URL=localhost:50053
# Workload identity (pnpm keys): this app's private key and every workload's public keys
WORKLOAD_KEY_FILE=../../.certs/workloads/gateway.jwk.json
WORKLOAD_KEYS_FILE=../../.certs/workload-keys.json
# Trusted identity providers (JSON array). Locally: the stack's dev IdP (tools/dev-idp.ts).
AUTH_ISSUERS=[{"issuer":"http://127.0.0.1:8090","audience":"ga-api","jwksUri":"http://127.0.0.1:8090/jwks.json","userinfoUri":"http://127.0.0.1:8090/userinfo"}]
AUTH_JWKS_UNKNOWN_KID_COOLDOWN_S=1
