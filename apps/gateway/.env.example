# Local development values (copy to .env). Validated at boot by src/config.ts.
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8443
TLS_ENABLED=true
TLS_CERT_FILE=../../.certs/dev-cert.pem
TLS_KEY_FILE=../../.certs/dev-key.pem
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=600
# /docs and /openapi.json; defaults to off when NODE_ENV=production
DOCS_ENABLED=true
USER_SERVICE_URL=localhost:50051
HOUSE_SERVICE_URL=localhost:50052
BOOKING_SERVICE_URL=localhost:50053
