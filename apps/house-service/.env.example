# Local development values; `pnpm new:service` copies this file to .env.
# Every variable is validated at boot (src/config.ts).
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true
GRPC_HOST=127.0.0.1
GRPC_PORT=50052
# gRPC TLS between workloads (pnpm certs). Plaintext is refused unless GRPC_HOST is loopback.
GRPC_TLS_CERT_FILE=../../.certs/grpc-server.pem
GRPC_TLS_KEY_FILE=../../.certs/grpc-server-key.pem
GRPC_TLS_CA_FILE=../../.certs/grpc-ca.pem
DATABASE_URL=postgresql://ga:ga@localhost:5432/ga_house
DB_POOL_MAX=10
USER_SERVICE_URL=localhost:50051
