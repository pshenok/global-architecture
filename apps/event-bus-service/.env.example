# Local development values; `pnpm new:service` copies this file to .env.
# Every variable is validated at boot (src/config.ts).
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true
GRPC_HOST=127.0.0.1
GRPC_PORT=50050
# gRPC TLS between workloads (pnpm certs). Plaintext is refused unless GRPC_HOST is loopback.
GRPC_TLS_CERT_FILE=../../.certs/grpc-server.pem
GRPC_TLS_KEY_FILE=../../.certs/grpc-server-key.pem
GRPC_TLS_CA_FILE=../../.certs/grpc-ca.pem
DATABASE_URL=postgresql://ga:ga@localhost:5432/ga_event_bus
DB_POOL_MAX=10
# Workload identity (pnpm keys): this app's private key and every workload's public keys
WORKLOAD_KEY_FILE=../../.certs/workloads/event-bus-service.jwk.json
WORKLOAD_KEYS_FILE=../../.certs/workload-keys.json
# Event delivery (ADR-0005)
EVENT_BUS_LEASE_S=30
EVENT_BUS_MAX_ATTEMPTS=10
EVENT_BUS_RETENTION_DAYS=7
